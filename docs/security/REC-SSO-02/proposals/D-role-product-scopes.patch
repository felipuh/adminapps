+def _approved_scope(membership, client_id, products):
+    # DRAFT D: empty policy grants no tenant scopes. Values are not approved.
+    policies = getattr(settings, "SMART3AI_SSO_SCOPE_POLICIES", {})
+    policy = policies.get(client_id, {})
+    role_scopes = set(policy.get("roles", {}).get(membership.role, []))
+    product_scopes = set()
+    for product in products:
+        if product.get("code") == policy.get("product") and product.get("access_allowed"):
+            product_scopes.update(product.get("scopes", []))
+    return " ".join(["openid", "profile", "email"] + sorted(role_scopes & product_scopes))
