+def _registered_sso_context(client_id, audience):
+    # DRAFT C: registration values require an approved per-environment inventory.
+    clients = getattr(settings, "SMART3AI_SSO_CLIENTS", {})
+    if not isinstance(clients, dict) or not isinstance(client_id, str):
+        return False
+    registration = clients.get(client_id, {})
+    if not isinstance(registration, dict):
+        return False
+    allowed = registration.get("audiences", [])
+    requested = [audience] if isinstance(audience, str) else audience
+    return bool(
+        isinstance(allowed, list) and allowed
+        and all(isinstance(value, str) and value for value in allowed)
+        and isinstance(requested, list) and requested
+        and all(isinstance(value, str) and value in allowed for value in requested)
+    )
+
