# Django Settings
ENVIRONMENT=development
DEBUG=True
DJANGO_SECRET_KEY=change-this-dev-secret-key-before-deploy
SMART3AI_SSO_JWT_SECRET=change-this-shared-sso-jwt-secret
SMART3AI_SSO_ISSUER=https://sso.smart3ai.local
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.100.100

# For production:
# ENVIRONMENT=production
# DEBUG=False
# DJANGO_SECRET_KEY=<set-a-secure-random-value>

# Database
DB_NAME=adminapps_db
DB_USER=adminapps_user
DB_PASSWORD=AdminApps2026
DB_HOST=127.0.0.1
DB_PORT=5432

# Browser/API security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
APPS_LOG_LEVEL=INFO
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=300/minute

# ISO Smart Integration
ISOSMART_API_URL=http://localhost:8000/api

# Owner organization billing exemption (Smart3AI)
BILLING_OWNER_ORG_EXEMPT_ENABLED=true
BILLING_OWNER_ORG_NAME=Smart3AI
# BILLING_OWNER_ORG_CODE=ORG00001
# BILLING_OWNER_ORG_ID=00000000-0000-0000-0000-000000000000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Production-like example overrides
#
# ENVIRONMENT=production
# DEBUG=False
# DJANGO_SECRET_KEY=replace_with_long_random_secret_from_secret_manager
# ALLOWED_HOSTS=adminapps.smart3ai.local,adminapps.isosmart.local
# CORS_ALLOWED_ORIGINS=https://adminapps.smart3ai.local,https://medsupplier.smart3ai.local
# CSRF_TRUSTED_ORIGINS=https://adminapps.smart3ai.local,https://medsupplier.smart3ai.local
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
