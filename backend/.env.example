# Django Settings
ENVIRONMENT=development
DEBUG=True
DJANGO_SECRET_KEY=change-this-dev-secret-key-before-deploy
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.100.100

# For production:
# ENVIRONMENT=production
# DEBUG=False
# DJANGO_SECRET_KEY=<set-a-secure-random-value>

# Database
DB_NAME=adminapps_db
DB_USER=adminapps_user
DB_PASSWORD=your_secure_password
DB_HOST=192.168.100.105
DB_PORT=3306

# Browser/API security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
APPS_LOG_LEVEL=INFO
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=300/minute

# ISO Smart Integration
ISOSMART_API_URL=http://localhost:8000/api

# Owner organization billing exemption (Smart3AI)
BILLING_OWNER_ORG_EXEMPT_ENABLED=true
BILLING_OWNER_ORG_NAME=Smart3AI
# BILLING_OWNER_ORG_CODE=ORG00001
# BILLING_OWNER_ORG_ID=00000000-0000-0000-0000-000000000000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
