#!/bin/sh
set -eu
export GITLEAKS="${GITLEAKS:-$HOME/.local/bin/gitleaks}"
# Use the installed trusted delivery checker even in quarantined old worktrees.
checker=$(dirname "$0")/../scripts/security/check_secrets.py
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    python3 "$checker" --ref "$local_oid" || exit 1
done
